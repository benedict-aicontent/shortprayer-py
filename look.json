{
  "_about": "On-screen text designs. Every video gets one random set for the hook and one random set for the prayer (sets are not repeated within a batch until all have been used). Add, remove or edit sets freely. Lines that start with an underscore are notes and are ignored.",
  "_fields": {
    "name": "any label, shown in the log",
    "font": "a font file name from C:\\Windows\\Fonts (for example georgiab.ttf) or a .ttf in the fonts folder",
    "font_size": "largest size, in pixels on a 1080px-wide video. Long text shrinks automatically to fit, never below min_font_size",
    "min_font_size": "smallest size the text may shrink to",
    "color": "text color, #RRGGBB",
    "line_spacing": "line height as a multiple of the font size",
    "align": "center, left or right",
    "margins": "px kept clear from the edges of the screen (left, right, top, bottom)",
    "zone": "where the text sits, as % of the screen height (top and bottom), and vertical_align (top, center or bottom) inside that area",
    "background": "enabled, color, opacity (0-1), radius (rounded corners), padding_x, padding_y: the box behind the text block",
    "outline": "width (px, 0 = none) and color around each letter",
    "shadow": "enabled, color, opacity, offset_x, offset_y, blur"
  },

